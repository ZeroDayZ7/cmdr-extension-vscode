  "configuration": {
    "title": "CMDR",
    "properties": {
      "cmdr.cli.source": {
        "type": "string",
        "enum": [
          "path",
          "custom",
          "managed"
        ],
        "enumDescriptions": [
          "Find CMDR in the system PATH.",
          "Use a custom executable path.",
          "Use the CLI installation managed by this extension."
        ],
        "default": "path",
        "description": "Selects how the CMDR executable is resolved."
      },
      "cmdr.cli.customPath": {
        "type": "string",
        "default": "",
        "description": "Full path to a custom CMDR executable."
      },
      "cmdr.cli.autoUpdate": {
        "type": "boolean",
        "default": false,
        "description": "Automatically install managed CMDR updates when available."
      },
      "cmdr.cli.versionCheck": {
        "type": "boolean",
        "default": true,
        "description": "Check managed CMDR versions periodically."
      }
    }
  },
