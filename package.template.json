{
  "name": "cli-helper",
  "displayName": "CMDR Tools",
  "description": "A developer productivity tool for code cleaning via CMDR CLI.",
  "license": "Apache-2.0",
  "publisher": "ZeroDayZ7",
  "author": {
    "name": "Neo"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeroDayZ7/cli-helper-cmdr-extension-vscode"
  },
  "version": "0.3.322",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension",
  "scripts": {
    "gen-manifest": "node scripts/build-manifest.js",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",

    "build:prod": "npm run gen-manifest && npm run check-types && node esbuild.js --production",
    "package:vsix": "powershell -ExecutionPolicy Bypass -Command \"npm run build:prod; vsce package\"",
    "build:full": "npm run package:vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
