{
  "name": "cli-helper",
  "displayName": "CMDR Tools",
  "description": "A developer productivity tool for code cleaning via CMDR CLI.",
  "license": "Apache-2.0",
  "publisher": "ZeroDayZ7",
  "author": {
    "name": "Neo"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeroDayZ7/cli-helper-cmdr-extension-vscode"
  },
  "version": "0.3.322",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension",
  "scripts": {
    "gen-manifest": "node scripts/build-manifest.js",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build:prod": "npm run gen-manifest && npm run check-types && node esbuild.js --production",
    "package:vsix": "powershell -ExecutionPolicy Bypass -Command \"npm run build:prod; vsce package\"",
    "build:full": "npm run package:vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "cli-helper.annotate",
        "title": "ANT - Annotate Project Path"
      },
      {
        "command": "cli-helper.annotateVerbose",
        "title": "ANT - Annotate (Verbose Logging)"
      },
      {
        "command": "cli-helper.annotateDryRun",
        "title": "ANT - Annotate (Dry Run Preview)"
      },
      {
        "command": "cli-helper.codeRegions",
        "title": "REG - Wrap into #regions"
      },
      {
        "command": "cli-helper.rmvComments",
        "title": "RMC - Remove Comments"
      },
      {
        "command": "cli-helper.treeClipboard",
        "title": "Tree - Copy Structure (Standard)"
      },
      {
        "command": "cli-helper.fcDart",
        "title": "FC - Combine Files (Detect)"
      },
      {
        "command": "cli-helper.treeAscii",
        "title": "Copy as ASCII"
      },
      {
        "command": "cli-helper.treeJson",
        "title": "Copy as JSON"
      },
      {
        "command": "cli-helper.treeCsv",
        "title": "Copy as CSV"
      },
      {
        "command": "cli-helper.treeMd",
        "title": "Copy as Markdown"
      },
      {
        "command": "cli-helper.preparePassword",
        "title": "BS - Prepare Passwords (Default 16)"
      },
      {
        "command": "cli-helper.preparePasswordCustom",
        "title": "BS - Prepare Passwords (Custom Length)"
      }
    ],
    "submenus": [
      {
        "id": "cli-helper.submenu",
        "label": "CMDR Tools"
      },
      {
        "id": "cli-helper.annotateOptions",
        "label": "ANT - Options & Preview"
      },
      {
        "id": "cli-helper.treeFormats",
        "label": "Tree - Special Formats"
      },
      {
        "id": "cli-helper.bootstrapOptions",
        "label": "BS - Prepare Password"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "cli-helper.submenu",
          "group": "7_modification"
        }
      ],
      "cli-helper.submenu": [
        {
          "command": "cli-helper.annotate",
          "group": "1_annotate@1"
        },
        {
          "submenu": "cli-helper.annotateOptions",
          "group": "1_annotate@2"
        },
        {
          "command": "cli-helper.codeRegions",
          "group": "1_modify@3"
        },
        {
          "command": "cli-helper.rmvComments",
          "group": "1_modify@4"
        },
        {
          "command": "cli-helper.treeClipboard",
          "group": "2_utils@1"
        },
        {
          "command": "cli-helper.fcDart",
          "group": "2_utils@2"
        },
        {
          "submenu": "cli-helper.bootstrapOptions",
          "group": "2_utils@3"
        },
        {
          "submenu": "cli-helper.treeFormats",
          "group": "3_tree_formats"
        }
      ],
      "cli-helper.bootstrapOptions": [
        {
          "command": "cli-helper.preparePassword",
          "group": "options@1"
        },
        {
          "command": "cli-helper.preparePasswordCustom",
          "group": "options@2"
        }
      ],
      "cli-helper.annotateOptions": [
        {
          "command": "cli-helper.annotateVerbose",
          "group": "options@1"
        },
        {
          "command": "cli-helper.annotateDryRun",
          "group": "options@2"
        }
      ],
      "cli-helper.treeFormats": [
        {
          "command": "cli-helper.treeAscii",
          "group": "1_formats@1"
        },
        {
          "command": "cli-helper.treeJson",
          "group": "1_formats@2"
        },
        {
          "command": "cli-helper.treeCsv",
          "group": "1_formats@3"
        },
        {
          "command": "cli-helper.treeMd",
          "group": "1_formats@4"
        }
      ]
    }
  }
}