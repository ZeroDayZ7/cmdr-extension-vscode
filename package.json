{
  "name": "cli-helper",
  "displayName": "CMDR Tools",
  "description": "A developer productivity tool for code cleaning via CMDR CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "publisher": "ZeroDayZ7",
  "author": {
    "name": "Neo"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeroDayZ7/cli-helper-cmdr-extension-vscode"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "gen-manifest": "node scripts/build-manifest.js",
    "validate:metadata": "node scripts/validate-project-metadata.js",
    "sync:metadata": "node scripts/sync-project-metadata.js",
    "prepare:metadata": "npm run gen-manifest && npm run sync:metadata && npm run validate:metadata",
    "test:manifest": "node --test scripts/build-manifest.test.js",
    "vscode:prepublish": "npm run build:prod",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run build:prod",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run test:manifest && npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build:prod": "npm run prepare:metadata && npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm run build:prod && vsce package",
    "build:full": "npm run package:vsix"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "strip-ansi": "^6.0.1",
    "tar": "^7.5.23"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/tar": "^6.1.13",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "version": "0.3.323",
  "contributes": {
    "commands": [
      {
        "category": "CMDR",
        "command": "cli-helper.annotate",
        "title": "Annotate Project Path"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.annotateVerbose",
        "title": "Annotate (Verbose Logging)"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.annotateDryRun",
        "title": "Annotate (Dry Run Preview)"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.codeRegions",
        "title": "Wrap into #regions"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.rmvComments",
        "title": "Remove Comments"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.treeClipboard",
        "title": "Copy Structure (Standard)"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.fcDart",
        "title": "Combine Files (Detect)"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.treeAscii",
        "title": "Copy as ASCII"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.treeJson",
        "title": "Copy as JSON"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.treeCsv",
        "title": "Copy as CSV"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.treeMd",
        "title": "Copy as Markdown"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.preparePassword",
        "title": "Prepare Passwords (Default 16)"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.preparePasswordCustom",
        "title": "Prepare Passwords (Custom Length)"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.cliStatus",
        "title": "CLI Status"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.cliUpdateCheck",
        "title": "Check CLI Updates"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.cliInstall",
        "title": "Install Managed CLI"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.cliUpdate",
        "title": "Update Managed CLI"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.cliConfigure",
        "title": "Configure CLI Source"
      },
      {
        "category": "CMDR",
        "command": "cli-helper.cliSettings",
        "title": "CLI Settings"
      }
    ],
    "configuration": {
      "properties": {
        "cmdr.cli.autoUpdate": {
          "default": false,
          "description": "Automatically install managed CMDR updates when available.",
          "type": "boolean"
        },
        "cmdr.cli.customPath": {
          "default": "",
          "description": "Full path to a custom CMDR executable.",
          "type": "string"
        },
        "cmdr.cli.githubRepository": {
          "default": "ZeroDayZ7/cmdr",
          "description": "GitHub owner and repository used for stable CMDR releases.",
          "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
          "patternErrorMessage": "Use the owner/repository format, for example ZeroDayZ7/cmdr.",
          "type": "string"
        },
        "cmdr.cli.source": {
          "default": "path",
          "description": "Selects how the CMDR executable is resolved.",
          "enum": [
            "path",
            "custom",
            "managed"
          ],
          "enumDescriptions": [
            "Find CMDR in the system PATH.",
            "Use a custom executable path.",
            "Use the CLI installation managed by this extension."
          ],
          "type": "string"
        },
        "cmdr.cli.versionCheck": {
          "default": true,
          "description": "Check managed CMDR versions periodically.",
          "type": "boolean"
        }
      },
      "title": "CMDR"
    },
    "menus": {
      "cli-helper.annotateOptions": [
        {
          "command": "cli-helper.annotateVerbose",
          "group": "options@1"
        },
        {
          "command": "cli-helper.annotateDryRun",
          "group": "options@2"
        }
      ],
      "cli-helper.submenu": [
        {
          "command": "cli-helper.annotate",
          "group": "1_annotate@1"
        },
        {
          "group": "1_annotate@2",
          "submenu": "cli-helper.annotateOptions"
        },
        {
          "command": "cli-helper.codeRegions",
          "group": "1_modify@3"
        },
        {
          "command": "cli-helper.rmvComments",
          "group": "1_modify@4"
        },
        {
          "command": "cli-helper.treeClipboard",
          "group": "2_utils@1"
        },
        {
          "command": "cli-helper.fcDart",
          "group": "2_utils@2"
        },
        {
          "group": "3_tree_formats",
          "submenu": "cli-helper.treeFormats"
        }
      ],
      "cli-helper.treeFormats": [
        {
          "command": "cli-helper.treeAscii",
          "group": "1_formats@1"
        },
        {
          "command": "cli-helper.treeJson",
          "group": "1_formats@2"
        },
        {
          "command": "cli-helper.treeCsv",
          "group": "1_formats@3"
        },
        {
          "command": "cli-helper.treeMd",
          "group": "1_formats@4"
        }
      ],
      "explorer/context": [
        {
          "group": "7_modification",
          "submenu": "cli-helper.submenu"
        }
      ]
    },
    "submenus": [
      {
        "id": "cli-helper.submenu",
        "label": "CMDR Tools"
      },
      {
        "id": "cli-helper.annotateOptions",
        "label": "ANT - Options & Preview"
      },
      {
        "id": "cli-helper.treeFormats",
        "label": "Tree - Special Formats"
      }
    ]
  }
}
