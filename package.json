{
  "name": "cli-helper",
  "displayName": "CMDR Tools",
  "description": "A developer productivity tool for code cleaning via CMDR CLI.",
  "license": "Apache-2.0",
  "publisher": "ZeroDayZ7",
  "author": {
    "name": "Neo"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeroDayZ7/cli-helper-cmdr-extension-vscode"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension",
  "contributes": {
    "commands": [
      {
        "command": "cli-helper.rmvComments",
        "title": "RMC - Remove Comments"
      },
      {
        "command": "cli-helper.treeClipboard",
        "title": "Tree - Copy Structure (Standard)"
      },
      {
        "command": "cli-helper.fcDart",
        "title": "FC - Combine Files (Dart Mode)"
      },
      {
        "command": "cli-helper.treeAscii",
        "title": "Copy as ASCII"
      },
      {
        "command": "cli-helper.treeJson",
        "title": "Copy as JSON"
      },
      {
        "command": "cli-helper.treeCsv",
        "title": "Copy as CSV"
      },
      {
        "command": "cli-helper.treeMd",
        "title": "Copy as Markdown"
      }
    ],
    "submenus": [
      {
        "id": "cli-helper.submenu",
        "label": "CMDR Tools"
      },
      {
        "id": "cli-helper.treeFormats",
        "label": "Tree - Special Formats"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "cli-helper.submenu",
          "group": "7_modification"
        }
      ],
      "cli-helper.submenu": [
        {
          "command": "cli-helper.rmvComments",
          "group": "1_main"
        },
        {
          "command": "cli-helper.treeClipboard",
          "group": "2_utils"
        },
        {
          "command": "cli-helper.fcDart",
          "group": "2_utils"
        },
        {
          "submenu": "cli-helper.treeFormats",
          "group": "3_tree_formats"
        }
      ],
      "cli-helper.treeFormats": [
        {
          "command": "cli-helper.treeAscii"
        },
        {
          "command": "cli-helper.treeJson"
        },
        {
          "command": "cli-helper.treeCsv"
        },
        {
          "command": "cli-helper.treeMd"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
